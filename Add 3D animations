/* =====================================================
   MISSION LAKSHYA NEET 2027
   STYLE + 3D LIVE ANIMATION
===================================================== */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  font-family: Arial, Helvetica, sans-serif;
  color: #f5f7ff;
  background:
    radial-gradient(circle at 15% 20%, rgba(0, 255, 200, .14), transparent 25%),
    radial-gradient(circle at 85% 15%, rgba(90, 100, 255, .16), transparent 25%),
    linear-gradient(135deg, #07111f, #0b1630 50%, #050914);
  overflow-x: hidden;
  transition: background .5s ease, color .5s ease;
}

/* =====================================================
   3D PARTICLE BACKGROUND
===================================================== */

#particles {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -5;
  overflow: hidden;
}

#particles::before,
#particles::after {
  content: "";
  position: absolute;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: rgba(255,255,255,.8);
  box-shadow:
    80px 120px rgba(255,255,255,.45),
    180px 400px rgba(0,255,220,.55),
    320px 180px rgba(255,255,255,.35),
    480px 520px rgba(90,150,255,.55),
    620px 90px rgba(255,255,255,.4),
    780px 350px rgba(0,255,220,.45),
    920px 150px rgba(255,255,255,.5),
    1080px 500px rgba(120,140,255,.5),
    1180px 260px rgba(255,255,255,.4);
  animation: particleFloat 12s linear infinite;
}

#particles::after {
  width: 3px;
  height: 3px;
  opacity: .6;
  animation-duration: 18s;
  animation-direction: reverse;
}

@keyframes particleFloat {
  0% {
    transform: translate3d(0, 0, 0) rotate(0deg);
  }

  50% {
    transform: translate3d(30px, -50px, 0) rotate(180deg);
  }

  100% {
    transform: translate3d(-20px, -100px, 0) rotate(360deg);
  }
}


/* =====================================================
   FLOATING 3D EMOJIS
===================================================== */

.floating-3d {
  position: fixed;
  z-index: -2;
  font-size: 58px;
  pointer-events: none;
  filter:
    drop-shadow(0 0 10px rgba(255,255,255,.25))
    drop-shadow(0 18px 25px rgba(0,0,0,.45));
  animation:
    floating3D 7s ease-in-out infinite,
    rotate3D 12s linear infinite;
  opacity: .24;
  transform-style: preserve-3d;
}

.dna {
  left: 4%;
  top: 20%;
}

.atom {
  right: 7%;
  top: 30%;
  animation-delay: -2s;
}

.doctor {
  left: 12%;
  bottom: 15%;
  animation-delay: -4s;
}

.physics {
  right: 15%;
  bottom: 20%;
  animation-delay: -1s;
}

.chemistry {
  left: 40%;
  top: 12%;
  animation-delay: -3s;
}

.engineering {
  right: 38%;
  bottom: 12%;
  animation-delay: -5s;
}

.rocket {
  right: 5%;
  top: 65%;
  animation-delay: -6s;
}

.ai3d {
  left: 45%;
  bottom: 25%;
  animation-delay: -2.5s;
}

@keyframes floating3D {
  0%, 100% {
    transform:
      translate3d(0,0,0)
      rotateX(0deg)
      rotateY(0deg);
  }

  50% {
    transform:
      translate3d(0,-35px,40px)
      rotateX(20deg)
      rotateY(25deg);
  }
}

@keyframes rotate3D {
  0% {
    filter:
      drop-shadow(0 0 8px rgba(255,255,255,.15));
  }

  50% {
    filter:
      drop-shadow(0 0 22px rgba(0,255,220,.35));
  }

  100% {
    filter:
      drop-shadow(0 0 8px rgba(255,255,255,.15));
  }
}


/* =====================================================
   HEADER
===================================================== */

.top-header {
  position: fixed;
  top: 0;
  left: 250px;
  right: 0;
  height: 76px;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 12px 24px;

  background: rgba(8, 15, 31, .78);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 190px;
}

.brand-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 15px;
  font-size: 27px;
  background: linear-gradient(145deg, #173d70, #07182e);
  box-shadow:
    inset 0 0 15px rgba(255,255,255,.08),
    0 10px 30px rgba(0,0,0,.3);
}

.brand h1 {
  font-size: 17px;
}

.brand strong {
  font-size: 12px;
  color: #65ffe4;
}

.search-box {
  flex: 1;
  max-width: 520px;
  display: flex;
  overflow: hidden;
  border-radius: 15px;
  background: rgba(255,255,255,.07);
  border: 1px solid rgba(255,255,255,.1);
}

.search-box input {
  flex: 1;
  border: 0;
  outline: none;
  background: transparent;
  color: white;
  padding: 13px 16px;
}

.search-box button {
  width: 52px;
  border: 0;
  background: rgba(0,255,220,.12);
  color: white;
  cursor: pointer;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 9px;
}

.header-actions > button {
  width: 42px;
  height: 42px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 13px;
  background: rgba(255,255,255,.06);
  color: white;
  cursor: pointer;
  transition: .3s;
}

.header-actions > button:hover {
  transform: translateY(-3px) rotateY(12deg);
  background: rgba(0,255,220,.15);
}

.profile {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
}

.profile b {
  color: #65ffe4;
}


/* =====================================================
   SIDEBAR
===================================================== */

.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: 250px;
  z-index: 110;
  padding: 20px 13px;
  background: rgba(5, 10, 23, .88);
  backdrop-filter: blur(20px);
  border-right: 1px solid rgba(255,255,255,.08);
}

.side-logo {
  height: 62px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 13px;
  margin-bottom: 22px;
  font-weight: 800;
  color: #fff;
}

.side-logo:first-letter {
  font-size: 30px;
}

.nav-btn {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 13px 15px;
  margin: 5px 0;
  border: 1px solid transparent;
  border-radius: 14px;
  background: transparent;
  color: #aeb9d2;
  font-size: 14px;
  text-align: left;
  cursor: pointer;
  transition: .3s;
}

.nav-btn:hover,
.nav-btn.active {
  color: white;
  background:
    linear-gradient(
      100deg,
      rgba(0,255,220,.13),
      rgba(70,100,255,.12)
    );
  border-color: rgba(0,255,220,.12);
  transform: translateX(4px);
  box-shadow: 0 8px 25px rgba(0,0,0,.2);
}


/* =====================================================
   MAIN
===================================================== */

.main-content {
  margin-left: 250px;
  padding: 100px 28px 50px;
  min-height: 100vh;
}

.page {
  display: none;
  animation: pageIn .5s ease;
}

.page.active {
  display: block;
}

@keyframes pageIn {
  from {
    opacity: 0;
    transform: translateY(15px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


/* =====================================================
   HERO
===================================================== */

.hero {
  position: relative;
  overflow: hidden;
  min-height: 330px;
  margin-bottom: 30px;
  padding: 30px;
  border-radius: 30px;

  background:
    radial-gradient(
      circle at 80% 30%,
      rgba(0,255,220,.13),
      transparent 28%
    ),
    linear-gradient(
      135deg,
      rgba(20,45,80,.9),
      rgba(10,18,38,.9)
    );

  border: 1px solid rgba(255,255,255,.09);
  box-shadow:
    0 30px 70px rgba(0,0,0,.3),
    inset 0 0 50px rgba(255,255,255,.02);
}

.hero::before {
  content: "";
  position: absolute;
  width: 300px;
  height: 300px;
  right: -100px;
  top: -100px;
  border-radius: 50%;
  border: 1px solid rgba(0,255,220,.18);
  box-shadow:
    0 0 40px rgba(0,255,220,.08),
    inset 0 0 40px rgba(0,255,220,.08);
  animation: orbit 9s linear infinite;
}

@keyframes orbit {
  to {
    transform: rotate(360deg);
  }
}

.hero-content {
  min-height: 270px;
  display: flex;
  align-items: center;
  gap: 25px;
  position: relative;
  z-index: 2;
}

.hero-3d-character {
  width: 135px;
  height: 135px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  font-size: 75px;
  border-radius: 35px;
  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.12),
      rgba(255,255,255,.025)
    );
  border: 1px solid rgba(255,255,255,.12);
  box-shadow:
    0 25px 50px rgba(0,0,0,.3),
    inset 0 0 25px rgba(255,255,255,.05);
  transform-style: preserve-3d;
  animation: hero3D 4s ease-in-out infinite;
}

@keyframes hero3D {
  0%,100% {
    transform: translateY(0) rotateY(-8deg);
  }

  50% {
    transform: translateY(-14px) rotateY(8deg);
  }
}

.small-title {
  color: #65ffe4;
  font-size: 11px;
  letter-spacing: 2px;
  margin-bottom: 9px;
}

.hero h2 {
  font-size: clamp(30px, 5vw, 58px);
  line-height: 1;
  margin-bottom: 14px;
}

.hero h2 span {
  display: block;
  color: #65ffe4;
  text-shadow: 0 0 25px rgba(0,255,220,.3);
}

.hero p {
  color: #b6c1d8;
  margin-bottom: 20px;
}

.primary-btn,
.hero button {
  padding: 13px 20px;
  border: 0;
  border-radius: 13px;
  color: #04151a;
  background: #65ffe4;
  font-weight: 800;
  cursor: pointer;
  transition: .3s;
  box-shadow: 0 10px 30px rgba(0,255,220,.18);
}

.primary-btn:hover,
.hero button:hover {
  transform: translateY(-4px) scale(1.02);
}

.hero-subjects {
  margin-left: auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.hero-subjects div {
  width: 100px;
  padding: 13px 8px;
  text-align: center;
  border-radius: 16px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.08);
  font-size: 12px;
  line-height: 1.6;
  transform-style: preserve-3d;
  animation: miniFloat 5s ease-in-out infinite;
}

.hero-subjects div:nth-child(2) {
  animation-delay: -.8s;
}

.hero-subjects div:nth-child(3) {
  animation-delay: -1.6s;
}

.hero-subjects div:nth-child(4) {
  animation-delay: -2.4s;
}

@keyframes miniFloat {
  0%,100% {
    transform: translateY(0) rotateX(0);
  }

  50% {
    transform: translateY(-7px) rotateX(8deg);
  }
}


/* =====================================================
   SECTION TITLE
===================================================== */

.section-title,
.page-header {
  margin: 28px 0 18px;
}

.section-title h2,
.page-header h2 {
  font-size: 24px;
  margin-bottom: 5px;
}

.section-title p,
.page-header p {
  color: #8996b0;
  font-size: 13px;
}


/* =====================================================
   CLASS SELECTOR
===================================================== */

.class-selector {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 15px;
}

.class-card {
  min-height: 100px;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 20px;
  color: white;
  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.08),
      rgba(255,255,255,.025)
    );
  cursor: pointer;
  transition: .35s;
  padding: 18px;
  text-align: left;
}

.class-card span {
  font-size: 25px;
  display: block;
  margin-bottom: 5px;
}

.class-card b {
  display: block;
  font-size: 17px;
}

.class-card small {
  display: block;
  margin-top: 5px;
  color: #93a1bb;
}

.class-card:hover,
.class-card.selected {
  transform: translateY(-6px) rotateX(2deg);
  border-color: rgba(0,255,220,.35);
  background:
    linear-gradient(
      145deg,
      rgba(0,255,220,.13),
      rgba(70,100,255,.09)
    );
  box-shadow:
    0 20px 45px rgba(0,0,0,.25),
    0 0 25px rgba(0,255,220,.08);
}

.selected-class {
  display: inline-block;
  margin: 5px 0 20px;
  padding: 9px 14px;
  border-radius: 20px;
  background: rgba(0,255,220,.08);
  color: #65ffe4;
  font-size: 13px;
}


/* =====================================================
   3D SUBJECT CARDS
===================================================== */

.subject-3d-grid {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 17px;
}

.subject-3d {
  position: relative;
  min-height: 220px;
  overflow: hidden;
  padding: 25px;
  border-radius: 24px;
  border: 1px solid rgba(255,255,255,.08);
  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.08),
      rgba(255,255,255,.025)
    );
  transform-style: preserve-3d;
  transition: .4s;
}

.subject-3d::after {
  content: "";
  position: absolute;
  width: 140px;
  height: 140px;
  right: -50px;
  top: -50px;
  border-radius: 50%;
  background: rgba(255,255,255,.04);
  filter: blur(5px);
}

.subject-3d:hover {
  transform:
    perspective(700px)
    rotateX(4deg)
    rotateY(-5deg)
    translateY(-8px);
  box-shadow:
    0 30px 50px rgba(0,0,0,.3);
}

.big-emoji {
  font-size: 58px;
  margin-bottom: 12px;
  filter: drop-shadow(0 12px 15px rgba(0,0,0,.35));
  animation: emoji3D 4s ease-in-out infinite;
}

@keyframes emoji3D {
  0%,100% {
    transform: translateY(0) rotateY(-5deg);
  }

  50% {
    transform: translateY(-8px) rotateY(8deg);
  }
}

.subject-3d h3 {
  font-size: 19px;
  margin-bottom: 7px;
}

.subject-3d p {
  color: #94a1ba;
  font-size: 12px;
  margin-bottom: 18px;
}

.subject-3d button {
  padding: 9px 13px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 10px;
  color: white;
  background: rgba(255,255,255,.06);
  cursor: pointer;
}


/* =====================================================
   FEATURE GRID
===================================================== */

.feature-grid {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 15px;
}

.feature-card {
  min-height: 135px;
  padding: 20px;
  text-align: left;
  color: white;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 20px;
  background: rgba(255,255,255,.045);
  cursor: pointer;
  transition: .35s;
}

.feature-card span {
  display: block;
  font-size: 32px;
  margin-bottom: 10px;
}

.feature-card b {
  display: block;
  margin-bottom: 5px;
}

.feature-card small {
  color: #8d9ab4;
}

.feature-card:hover {
  transform:
    perspective(600px)
    translateY(-8px)
    rotateX(4deg);
  border-color: rgba(0,255,220,.2);
  background: rgba(0,255,220,.07);
  box-shadow: 0 25px 45px rgba(0,0,0,.25);
}


/* =====================================================
   PROGRESS
===================================================== */

.progress-box {
  margin-top: 25px;
  padding: 22px;
  border-radius: 24px;
  background: rgba(255,255,255,.045);
  border: 1px solid rgba(255,255,255,.08);
  display: flex;
  align-items: center;
  gap: 30px;
}

.progress-box h2 {
  font-size: 20px;
}

.progress-box p {
  color: #8d9ab4;
  font-size: 12px;
  margin-top: 5px;
}

.progress-circle {
  width: 105px;
  height: 105px;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  background:
    radial-gradient(
      circle,
      #0b1930 54%,
      transparent 55%
    ),
    conic-gradient(
      #65ffe4 78%,
      rgba(255,255,255,.07) 0
    );

  box-shadow:
    0 0 30px rgba(0,255,220,.12);
}

.progress-circle b {
  font-size: 21px;
}

.progress-circle small {
  color: #8d9ab4;
  font-size: 10px;
}

.progress-stats {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.progress-stats div {
  padding: 15px;
  border-radius: 15px;
  background: rgba(255,255,255,.04);
  color: #aeb9d2;
  font-size: 12px;
}

.progress-stats b {
  display: block;
  color: white;
  font-size: 18px;
  margin: 5px 0;
}


/* =====================================================
   COMMON CARDS
===================================================== */

.book-grid,
.test-grid,
.website-grid,
.result-grid {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 17px;
}

.book-card,
.test-card,
.website-card,
.dpp-card,
.quiz-card,
.live-placeholder,
.live-chat-box,
.video-placeholder,
.settings-card,
.ai-box {
  padding: 25px;
  border-radius: 22px;
  border: 1px solid rgba(255,255,255,.08);
  background: rgba(255,255,255,.045);
  box-shadow: 0 15px 40px rgba(0,0,0,.15);
}

.book-card span,
.test-card span {
  font-size: 45px;
}

.book-card h3,
.test-card h3,
.website-card h3 {
  margin: 10px 0 7px;
}

.book-card p,
.test-card p,
.website-card p {
  color: #8d9ab4;
  font-size: 13px;
  margin-bottom: 15px;
}

.book-card button,
.test-card button,
.website-card button,
.dpp-card button,
.quiz-card button,
.live-placeholder button,
.youtube-toolbar button {
  padding: 10px 15px;
  border: 0;
  border-radius: 11px;
  background: #65ffe4;
  color: #031619;
  font-weight: 700;
  cursor: pointer;
  transition: .3s;
}

.book-card button:hover,
.test-card button:hover,
.website-card button:hover {
  transform: translateY(-3px);
}


/* =====================================================
   DPP / QUIZ
===================================================== */

.dpp-card,
.quiz-card {
  text-align: center;
  max-width: 650px;
  margin: 30px auto;
}

.dpp-card .big-emoji,
.quiz-icon {
  font-size: 70px;
}

.dpp-card p,
.quiz-card p {
  color: #8d9ab4;
  margin: 10px 0 20px;
}


/* =====================================================
   AI
===================================================== */

.ai-box {
  max-width: 900px;
  margin: auto;
  overflow: hidden;
}

.ai-avatar {
  width: 75px;
  height: 75px;
  display: grid;
  place-items: center;
  margin-bottom: 15px;
  border-radius: 22px;
  font-size: 43px;
  background:
    linear-gradient(
      145deg,
      rgba(0,255,220,.13),
      rgba(70,100,255,.12)
    );
  animation: aiFloat 3s ease-in-out infinite;
}

@keyframes aiFloat {
  0%,100% {
    transform: translateY(0) rotateY(-5deg);
  }

  50% {
    transform: translateY(-10px) rotateY(5deg);
  }
}

.ai-messages {
  min-height: 230px;
  max-height: 430px;
  overflow-y: auto;
  padding: 10px;
  margin-bottom: 15px;
}

.ai-message,
.user-message {
  max-width: 80%;
  padding: 12px 15px;
  margin: 8px 0;
  border-radius: 14px;
  line-height: 1.6;
  font-size: 13px;
}

.ai-message {
  background: rgba(0,255,220,.07);
  border: 1px solid rgba(0,255,220,.08);
}

.user-message {
  margin-left: auto;
  background: rgba(70,100,255,.12);
}

.ai-input {
  display: flex;
  gap: 10px;
}

.ai-input textarea {
  flex: 1;
  min-height: 80px;
  resize: vertical;
  padding: 14px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.08);
  outline: none;
  color: white;
  background: rgba(0,0,0,.2);
}

.ai-input button {
  align-self: flex-end;
  padding: 13px 18px;
  border: 0;
  border-radius: 12px;
  background: #65ffe4;
  color: #031619;
  font-weight: 800;
  cursor: pointer;
}


/* =====================================================
   YOUTUBE
===================================================== */

.youtube-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 18px;
}

.youtube-toolbar button {
  color: white;
  background: rgba(255,255,255,.07);
  border: 1px solid rgba(255,255,255,.08);
}

.youtube-toolbar button:hover {
  background: rgba(255,0,0,.15);
}

.youtube-area {
  min-height: 260px;
}

.live-placeholder {
  text-align: center;
}

.live-placeholder > div {
  font-size: 65px;
  margin-bottom: 10px;
}

.live-placeholder p {
  color: #8d9ab4;
  margin: 10px 0 20px;
}

.live-chat-box {
  margin-top: 18px;
}

.live-chat-box p {
  color: #8d9ab4;
  margin-top: 8px;
}


/* =====================================================
   THEMES
===================================================== */

.theme-grid {
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.theme-grid button {
  min-height: 80px;
  padding: 15px;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,.08);
  color: white;
  background: rgba(255,255,255,.05);
  cursor: pointer;
  transition: .35s;
}

.theme-grid button:hover {
  transform:
    translateY(-7px)
    rotateX(4deg);
  border-color: rgba(0,255,220,.3);
  box-shadow:
    0 20px 35px rgba(0,0,0,.25);
}


