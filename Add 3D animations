/* =====================================================
   NO 3D MODE
===================================================== */

body.no-3d .floating-3d {
  display: none;
}

body.no-3d .subject-3d,
body.no-3d .feature-card,
body.no-3d .class-card,
body.no-3d .hero-3d-character {
  transform: none !important;
  animation: none !important;
}


/* =====================================================
   SETTINGS
===================================================== */

.settings-card {
  max-width: 700px;
}

.settings-card label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 5px;
  border-bottom: 1px solid rgba(255,255,255,.07);
  color: #c2cbe0;
}

.settings-card input {
  width: 20px;
  height: 20px;
}


/* =====================================================
   RESULTS
===================================================== */

.result-grid {
  grid-template-columns: repeat(4, 1fr);
}

.result-grid div {
  padding: 25px;
  border-radius: 20px;
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(255,255,255,.08);
  text-align: center;
  font-size: 15px;
}

.result-grid b {
  display: block;
  margin: 8px 0;
  font-size: 27px;
}


/* =====================================================
   FOOTER
===================================================== */

footer {
  margin-left: 250px;
  padding: 30px;
  text-align: center;
  color: #78859e;
  border-top: 1px solid rgba(255,255,255,.06);
}

footer b {
  color: #65ffe4;
}


/* =====================================================
   LIGHT MODE
===================================================== */

body.light-mode .top-header,
body.light-mode .sidebar {
  background: rgba(255,255,255,.78);
  border-color: rgba(0,0,0,.07);
}

body.light-mode .nav-btn {
  color: #526078;
}

body.light-mode .nav-btn.active,
body.light-mode .nav-btn:hover {
  color: #172034;
}

body.light-mode .search-box input,
body.light-mode .header-actions > button,
body.light-mode .class-card,
body.light-mode .subject-3d,
body.light-mode .feature-card,
body.light-mode .book-card,
body.light-mode .test-card,
body.light-mode .website-card,
body.light-mode .dpp-card,
body.light-mode .quiz-card,
body.light-mode .live-placeholder,
body.light-mode .live-chat-box,
body.light-mode .video-placeholder,
body.light-mode .settings-card,
body.light-mode .ai-box {
  color: #182033;
}

body.light-mode .search-box input {
  color: #182033;
}

body.light-mode .section-title p,
body.light-mode .page-header p,
body.light-mode .subject-3d p,
body.light-mode .feature-card small,
body.light-mode .book-card p,
body.light-mode .test-card p,
body.light-mode .website-card p {
  color: #66738c;
}


/* =====================================================
   RESPONSIVE TABLET
===================================================== */

@media (max-width: 1150px) {

  .subject-3d-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .feature-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .theme-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .book-grid,
  .test-grid,
  .website-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero-subjects {
    display: none;
  }

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 800px) {

  .sidebar {
    position: fixed;
    width: 100%;
    height: 65px;
    top: auto;
    bottom: 0;
    left: 0;
    padding: 5px;
    display: flex;
    overflow-x: auto;
    border-right: 0;
    border-top: 1px solid rgba(255,255,255,.08);
  }

  .side-logo {
    display: none;
  }

  .nav-btn {
    min-width: 75px;
    width: auto;
    height: 54px;
    padding: 5px;
    margin: 0 2px;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    font-size: 18px;
  }

  .nav-btn span {
    font-size: 9px;
  }

  .top-header {
    left: 0;
    height: auto;
    min-height: 68px;
    padding: 10px;
    gap: 8px;
  }

  .brand {
    min-width: auto;
  }

  .brand h1,
  .brand strong {
    display: none;
  }

  .brand-icon {
    width: 42px;
    height: 42px;
  }

  .search-box {
    max-width: none;
  }

  .header-actions {
    gap: 4px;
  }

  .header-actions > button {
    width: 36px;
    height: 36px;
  }

  .profile {
    display: none;
  }

  .main-content {
    margin-left: 0;
    padding:
      90px 13px 85px;
  }

  footer {
    margin-left: 0;
    margin-bottom: 65px;
  }

  .hero {
    min-height: auto;
    padding: 20px;
    border-radius: 22px;
  }

  .hero-content {
    min-height: auto;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-3d-character {
    width: 90px;
    height: 90px;
    font-size: 52px;
  }

  .hero h2 {
    font-size: 36px;
  }

  .class-selector {
    grid-template-columns: 1fr;
  }

  .subject-3d-grid,
  .feature-grid,
  .book-grid,
  .test-grid,
  .website-grid {
    grid-template-columns: 1fr;
  }

  .theme-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .progress-box {
    flex-direction: column;
    align-items: flex-start;
  }

  .progress-stats {
    width: 100%;
    grid-template-columns: repeat(2, 1fr);
  }

  .result-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .ai-input {
    flex-direction: column;
  }

  .ai-input button {
    align-self: stretch;
  }

  .floating-3d {
    font-size: 38px;
    opacity: .15;
  }

}


/* =====================================================
   SMALL MOBILE
===================================================== */

@media (max-width: 450px) {

  .hero h2 {
    font-size: 30px;
  }

  .theme-grid {
    grid-template-columns: 1fr;
  }

  .result-grid {
    grid-template-columns: 1fr 1fr;
  }

  .progress-stats {
    grid-template-columns: 1fr 1fr;
  }

  .subject-3d {
    min-height: 190px;
  }

  .youtube-toolbar {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

}


/* =====================================================
   REDUCED MOTION
===================================================== */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }

}
